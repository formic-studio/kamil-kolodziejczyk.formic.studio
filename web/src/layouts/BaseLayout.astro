---
import '../styles/legacy/normalize.css';
import '../styles/legacy/webflow.css';
import '../styles/legacy/site.css';
import '../styles/global.css';
import type {SanityImage, SiteSettings} from '../lib/content';
import {imageUrl} from '../lib/content';

interface Props { settings: SiteSettings; isProduction: boolean; mobileLcpImage?: SanityImage }
const {settings, isProduction, mobileLcpImage} = Astro.props;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
const ogImage = imageUrl(settings.ogImage);
const siteOrigin = canonical?.origin || 'https://kamil-kolodziejczyk.formic.studio';
const siteUrl = `${siteOrigin}/`;
const structuredData = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}#website`,
      url: siteUrl,
      name: settings.title,
      description: settings.description,
      inLanguage: 'pl-PL',
    },
    {
      '@type': 'Person',
      '@id': `${siteUrl}#person`,
      name: 'Kamil Kołodziejczyk',
      url: siteUrl,
      jobTitle: 'Low-code developer',
      description: settings.description,
      email: `mailto:${settings.email}`,
      telephone: settings.phone,
      image: ogImage || undefined,
      sameAs: (settings.socialLinks || []).map((link) => link.url),
    },
  ],
}).replace(/</g, '\\u003c');
---
<!doctype html>
<html lang="pl-PL">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={settings.description} />
    <meta name="author" content="Kamil Kołodziejczyk" />
    <meta name="google-site-verification" content="kMuHlDCJpey9K5HJKHik6W7ox7BrzNkseJj4afNrAE8" />
    <meta name="robots" content={isProduction ? 'index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1' : 'noindex,nofollow,noarchive'} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pl_PL" />
    <meta property="og:site_name" content="Kamil Kołodziejczyk" />
    <meta property="og:title" content={settings.title} />
    <meta property="og:description" content={settings.description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    {settings.ogImage?.alt && <meta property="og:image:alt" content={settings.ogImage.alt} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={settings.title} />
    <meta name="twitter:description" content={settings.description} />
    <meta name="twitter:image" content={ogImage} />
    {settings.ogImage?.alt && <meta name="twitter:image:alt" content={settings.ogImage.alt} />}
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="alternate" hreflang="pl-PL" href={canonical || siteUrl} />
    <link rel="alternate" hreflang="x-default" href={canonical || siteUrl} />
    <link rel="preconnect" href="https://cdn.sanity.io" crossorigin="anonymous" />
    {mobileLcpImage?.asset?.url && <link
      rel="preload"
      as="image"
      href={imageUrl(mobileLcpImage, 800)}
      imagesrcset={`${imageUrl(mobileLcpImage, 500)} 500w, ${imageUrl(mobileLcpImage, 800)} 800w`}
      imagesizes="(max-width: 479px) 50vw, 56vw"
      media="(max-width: 767px)"
      fetchpriority="high"
    />}
    <link rel="icon" href="/images/favicon.png" />
    <link rel="apple-touch-icon" href="/images/webclip.png" />
    <title>{settings.title}</title>
    <script type="application/ld+json" set:html={structuredData} />
    <script is:inline>
      if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
      window.scrollTo(0, 0);
      if (!window.matchMedia('(max-width: 767px)').matches && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('is-intro-loading');
      }
    </script>
  </head>
  <body class="body">
    <slot />
    <script>
      import '../scripts/main';
    </script>
  </body>
</html>
