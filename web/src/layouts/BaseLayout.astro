---
import '../styles/legacy/normalize.css';
import '../styles/legacy/webflow.css';
import '../styles/legacy/site.css';
import '../styles/global.css';
import type {SanityImage, SiteSettings} from '../lib/content';
import {imageUrl} from '../lib/content';

interface Props { settings: SiteSettings; isProduction: boolean; mobileLcpImage?: SanityImage }
const {settings, isProduction, mobileLcpImage} = Astro.props;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
---
<!doctype html>
<html lang="pl-PL">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={settings.description} />
    <meta name="robots" content={isProduction ? 'index,follow' : 'noindex,nofollow'} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={settings.title} />
    <meta property="og:description" content={settings.description} />
    <meta property="og:image" content={imageUrl(settings.ogImage)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={settings.title} />
    <meta name="twitter:description" content={settings.description} />
    <meta name="twitter:image" content={imageUrl(settings.ogImage)} />
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="preconnect" href="https://cdn.sanity.io" crossorigin="anonymous" />
    {mobileLcpImage?.asset?.url && <link
      rel="preload"
      as="image"
      href={imageUrl(mobileLcpImage, 800)}
      imagesrcset={`${imageUrl(mobileLcpImage, 500)} 500w, ${imageUrl(mobileLcpImage, 800)} 800w`}
      imagesizes="(max-width: 479px) 50vw, 56vw"
      media="(max-width: 767px)"
      fetchpriority="high"
    />}
    <link rel="icon" href="/images/favicon.png" />
    <link rel="apple-touch-icon" href="/images/webclip.png" />
    <title>{settings.title}</title>
    <script is:inline>
      if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
      window.scrollTo(0, 0);
      if (!window.matchMedia('(max-width: 767px)').matches && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('is-intro-loading');
      }
    </script>
  </head>
  <body class="body">
    <slot />
    <script>
      import '../scripts/main';
    </script>
  </body>
</html>
