---
import type {HomePage} from '../lib/content';
import {imageUrl} from '../lib/content';
const {page} = Astro.props as {page: HomePage};
---
<section id="section_hero" class="section_hero">
  <div class="padding-global padding-section-medium _100"><div class="container-large _100">
    <div class="rectangle-wrapper">
      <div animation-rectangle="0" class="rectangle-small"></div>
      <div class="rectangle-block-secendary"><div animation-rectangle="2" class="rectangle-small secendary"></div><div animation-rectangle="1" class="rectangle-small secendary"></div></div>
      <div animation-rectangle="3" class="rectangle-small last"></div>
    </div>
    <div class="hero-wrapper">
      <div class="flex-vertical-center-top gap-3"><div class="grid-12">
        <div id="w-node-_8e23c23c-8602-021f-2197-906c4058e766-bb3bdf83" animation-data="text-hero" class="heading-style-h3 text-align-center preserve-lines">{page.heroEyebrow}</div>
        <div animation-data="button" class="link-block-wrapper mobile-display-none"><button type="button" data-popup="open" class="button-block hero-cta"><span class="button-bg-orange"></span><span class="text-button">{page.heroCta}</span></button></div>
      </div></div>
      <img src={imageUrl(page.heroImage, 1600)} srcset={`${imageUrl(page.heroImage, 500)} 500w, ${imageUrl(page.heroImage, 800)} 800w, ${imageUrl(page.heroImage, 1080)} 1080w, ${imageUrl(page.heroImage, 1600)} 1600w, ${imageUrl(page.heroImage, 2400)} 2400w`} sizes="100vw" width="3456" height="1296" loading="eager" fetchpriority="high" alt={page.heroImage.alt || ''} class="img-hero" />
      <img src={imageUrl(page.heroImageMobile, 800)} width="800" height="1000" loading="eager" alt={page.heroImageMobile.alt || ''} class="img-hero is-mobile" />
      <div animation-data="caption" class="flex-vertical-center-top gap-2-5"><div class="text-caption text-style-uppercase font-color-tertiary preserve-lines">{page.heroCaption}</div><div class="rectangle"></div></div>
    </div>
  </div></div>
</section>

<section id="section_offer" class="section_offer">
  <div class="padding-global padding-section-medium"><div class="container-large"><div class="offer-block">
    <div class="flex-vertical-center-top gap-5-5 max-width-66">
      <div class="heading-style-h3 text-align-center preserve-lines">{page.offerIntro}</div>
      <h1 text-animation="true" class="heading-style-h2 text-align-center">{page.offerHeading}</h1>
      <div class="button-caption"><div>Co oferuję?</div></div>
    </div>
    <div class="flex-horizontal-left gap-3-75 padding-top-6">
      {page.offers.map((offer, index) => <div data-offer={index} class="flex-vertical-left gap-0-75 mobile-center"><div class="text-caption text-style-uppercase">{offer.number} | {offer.title}</div><p class="text-body-small mobile-center">{offer.description}</p></div>)}
    </div>
  </div></div></div>
</section>
