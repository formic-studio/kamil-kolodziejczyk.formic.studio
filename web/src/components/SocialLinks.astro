    const platform = link.label.toLowerCase();
    const isLinkedIn = platform.includes('linkedin');
    const isBehance = platform.includes('behance');
    const isInstagram = platform.includes('instagram');

    return <a aria-label={`Przejdź do ${link.label}`} href={link.url} target="_blank" rel="noreferrer" class:list={['social-link-block','w-inline-block', dark && 'hover-color-black']}>
